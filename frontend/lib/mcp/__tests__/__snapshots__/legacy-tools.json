          "description": "The full trip_id from list_trips."
        },
        "day": {
          "description": "Only this day number.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "trip_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
