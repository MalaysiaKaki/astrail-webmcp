{
  "name": "astrail-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:widgets && next build",
    "start": "next start",
    "typecheck": "npm run build:widgets && tsc --noEmit && npm run typecheck:widgets",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:widgets": "vite build --config mcp-app/vite.config.ts && node mcp-app/scripts/emit-module.mjs",
    "typecheck:widgets": "tsc --noEmit -p mcp-app/tsconfig.json",
    "check:widget-casts": "node mcp-app/scripts/check-casts.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "4.3.1",
    "cobe": "^2.0.1",
    "gsap": "^3.15.0",
    "jose": "6.2.12",
    "lenis": "^1.3.25",
    "mapbox-gl": "3.24.0",
    "motion": "^12.43.0",
    "next": "15.5.19",
    "postcss": "^8.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1",
    "three": "^0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^2.1.9"
  }
}
